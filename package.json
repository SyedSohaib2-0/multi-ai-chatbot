{
  "name": "advanced-multi-ai-chatbot",
  "version": "3.0.0",
  "description": "Advanced Multi-AI Chatbot with OpenAI, DeepSeek, Ollama integration and real-time Google Search",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build step required for this project'",
    "test": "node --experimental-modules test/basic.test.js",
    "lint": "eslint *.js --fix",
    "format": "prettier --write *.js *.html *.css",
    "setup": "npm install && npm run setup-models",
    "setup-models": "echo 'Setting up Ollama models...' && ollama pull llama3.2:latest && ollama pull gemma2:latest && ollama pull mistral:latest && ollama pull codellama:latest",
    "health": "curl -f http://localhost:3000/api/health || echo 'Server not running'",
    "stats": "curl -s http://localhost:3000/api/stats | jq",
    "clear-cache": "curl -X POST http://localhost:3000/api/cache/clear",
    "test-openai": "node -e \"console.log('Testing OpenAI connection...')\" && curl -X POST http://localhost:3000/api/providers/switch -H 'Content-Type: application/json' -d '{\"provider\":\"openai\"}'",
    "test-deepseek": "node -e \"console.log('Testing DeepSeek connection...')\" && curl -X POST http://localhost:3000/api/providers/switch -H 'Content-Type: application/json' -d '{\"provider\":\"deepseek\"}'",
    "test-ollama": "node -e \"console.log('Testing Ollama connection...')\" && curl -X POST http://localhost:3000/api/providers/switch -H 'Content-Type: application/json' -d '{\"provider\":\"ollama\"}'",
    "test-search": "curl -s 'http://localhost:3000/api/search/test/latest%20AI%20news' | jq",
    "benchmark": "node benchmark.js",
    "docker-build": "docker build -t advanced-ai-chatbot .",
    "docker-run": "docker run -p 3000:3000 -e NODE_ENV=production advanced-ai-chatbot",
    "pm2-start": "pm2 start ecosystem.config.js",
    "pm2-stop": "pm2 stop ecosystem.config.js",
    "pm2-restart": "pm2 restart ecosystem.config.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "monitor": "node scripts/monitor.js"
  },
  "keywords": [
    "ai",
    "chatbot",
    "openai",
    "gpt-4",
    "deepseek",
    "ollama",
    "llama",
    "gemma",
    "mistral",
    "multi-ai",
    "google-search",
    "real-time",
    "fast-ai",
    "streaming",
    "web-search",
    "node-cache",
    "express",
    "modern-ui",
    "performance",
    "scalable",
    "enterprise"
  ],
  "author": "Advanced AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/advanced-multi-ai-chatbot.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/advanced-multi-ai-chatbot/issues"
  },
  "homepage": "https://github.com/yourusername/advanced-multi-ai-chatbot#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-fetch": "^3.3.2",
    "node-cache": "^5.1.2",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1",
    "moment": "^2.29.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "joi": "^17.11.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "socket.io": "^4.7.4",
    "redis": "^4.6.10",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "pdf-parse": "^1.1.1",
    "mammoth": "^1.6.0",
    "csv-parser": "^3.0.0",
    "xlsx": "^0.18.5",
    "node-cron": "^3.0.3",
    "express-validator": "^7.0.1",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/node": "^20.10.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0"
  },
  "optionalDependencies": {
    "puppeteer": "^21.6.1",
    "playwright": "^1.40.1",
    "tensorflow": "^4.15.0",
    "@tensorflow/tfjs-node": "^4.15.0"
  },
  "peerDependencies": {
    "ollama": ">=0.1.0"
  },
  "config": {
    "default_port": 3000,
    "max_message_length": 8000,
    "cache_duration": 300,
    "search_cache_duration": 1800,
    "rate_limit_window": 900000,
    "rate_limit_max": 1000
  },
  "directories": {
    "lib": "./lib",
    "test": "./test",
    "public": "./public",
    "logs": "./logs",
    "scripts": "./scripts"
  },
  "files": [
    "server.js",
    "public/",
    "lib/",
    "scripts/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "*.js",
      "lib/**/*.js",
      "!node_modules/**",
      "!test/**"
    ],
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "prettier"
    ],
    "env": {
      "node": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "node/no-unsupported-features/es-syntax": "off"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  }
}
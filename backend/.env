# ===================================================================
# ADVANCED MULTI-AI CHATBOT - ENVIRONMENT CONFIGURATION
# ===================================================================
# Version: 3.0.0
# Last Updated: $(date)
# Documentation: https://github.com/yourusername/advanced-multi-ai-chatbot
# ===================================================================

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
SERVER_NAME="Advanced Multi-AI Chatbot"
API_VERSION=v1

# Security Settings
JWT_SECRET=your_super_secure_jwt_secret_change_this_in_production_2024
SESSION_SECRET=your_session_secret_change_this_in_production_2024
API_KEY_HEADER=X-API-Key
ENCRYPTION_KEY=your_32_character_encryption_key_here

# CORS Settings
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key

# ===================================================================
# AI PROVIDERS CONFIGURATION
# ===================================================================

# OpenAI Configuration
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TOP_P=0.9
OPENAI_FREQUENCY_PENALTY=0.1
OPENAI_PRESENCE_PENALTY=0.1
OPENAI_TIMEOUT=30000

# DeepSeek Configuration
DEEPSEEK_API_KEY=sk-6118215940fa4022aee05dd59283fca1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MAX_TOKENS=1500
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_TOP_P=0.9
DEEPSEEK_TIMEOUT=30000

# Ollama Configuration (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
OLLAMA_DEFAULT_MODEL=llama3.2:latest
OLLAMA_FAST_MODEL=gemma2:latest
OLLAMA_CODE_MODEL=codellama:latest
OLLAMA_TIMEOUT=45000
OLLAMA_KEEP_ALIVE=5m

# Provider Selection Strategy
DEFAULT_PROVIDER=auto
PROVIDER_FALLBACK_ENABLED=true
PROVIDER_RETRY_COUNT=2
PROVIDER_SELECTION_STRATEGY=intelligent

# ===================================================================
# GOOGLE SEARCH CONFIGURATION
# ===================================================================

# Google Custom Search API
GOOGLE_CUSTOM_SEARCH_API_KEY=AIzaSyDm7uUslpZCp9m0_Q2KnkOr7dHgm9xjZHY
GOOGLE_SEARCH_ENGINE_ID=57aad852a1a8442b9

# SerpApi (Alternative Google Search)
SERPAPI_KEY=86cc1b0e5cf12d9659803cfa76422e34
SERPAPI_BASE_URL=https://serpapi.com/search.json

# Search Configuration
SEARCH_ENABLED=true
SEARCH_DEFAULT_RESULTS=8
SEARCH_MAX_RESULTS=15
SEARCH_TIMEOUT=10000
SEARCH_SAFE_MODE=medium
SEARCH_COUNTRY=us
SEARCH_LANGUAGE=en
SEARCH_DATE_RESTRICT=m1
SEARCH_AUTO_DETECT=true

# DuckDuckGo Fallback
DUCKDUCKGO_ENABLED=true
DUCKDUCKGO_BASE_URL=https://api.duckduckgo.com

# ===================================================================
# CACHING CONFIGURATION
# ===================================================================

# Multi-Layer Cache Settings
CACHE_ENABLED=true
CACHE_PROVIDER=memory
CACHE_REDIS_URL=redis://localhost:6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0

# Cache Duration Settings (in seconds)
RESPONSE_CACHE_TTL=300
SEARCH_CACHE_TTL=1800
AI_CACHE_TTL=180
MODEL_CACHE_TTL=3600
STATIC_CACHE_TTL=86400

# Cache Limits
CACHE_MAX_KEYS=10000
CACHE_MEMORY_LIMIT=512
CACHE_CHECK_PERIOD=60

# Cache Cleanup
CACHE_CLEANUP_INTERVAL=300
CACHE_AUTO_CLEANUP=true

# ===================================================================
# PERFORMANCE & RATE LIMITING
# ===================================================================

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_MESSAGE="Too many requests. Please try again later."
RATE_LIMIT_SKIP_SUCCESS_REQUESTS=false

# Request Limits
MAX_MESSAGE_LENGTH=8000
MAX_BATCH_SIZE=10
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=60000

# Performance Monitoring
PERFORMANCE_TRACKING=true
METRICS_ENABLED=true
STATS_UPDATE_INTERVAL=10000
PERFORMANCE_LOG_THRESHOLD=5000

# Memory Management
MEMORY_LIMIT=1024
MEMORY_WARNING_THRESHOLD=80
MEMORY_CLEANUP_INTERVAL=300000

# ===================================================================
# DATABASE CONFIGURATION (Optional)
# ===================================================================

# MongoDB (for message history & analytics)
MONGODB_URI=mongodb://localhost:27017/ai_chatbot
MONGODB_OPTIONS=retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT=10000

# PostgreSQL (alternative database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=secure_password_change_this
POSTGRES_DB=ai_chatbot
POSTGRES_SSL=false
POSTGRES_POOL_MIN=0
POSTGRES_POOL_MAX=10

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================

# Log Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14
LOG_COMPRESS=true

# Log Files
LOG_DIR=logs
ERROR_LOG_FILE=error.log
COMBINED_LOG_FILE=combined.log
ACCESS_LOG_FILE=access.log

# Console Logging
CONSOLE_LOG_ENABLED=true
CONSOLE_LOG_LEVEL=info
CONSOLE_LOG_COLORIZE=true

# ===================================================================
# SECURITY CONFIGURATION
# ===================================================================

# Helmet Security Headers
HELMET_ENABLED=true
CONTENT_SECURITY_POLICY=false
CROSS_ORIGIN_EMBEDDER_POLICY=false

# SSL/TLS (for production)
SSL_ENABLED=false
SSL_KEY_PATH=/path/to/private-key.pem
SSL_CERT_PATH=/path/to/certificate.pem
SSL_CA_PATH=/path/to/ca-certificate.pem
SSL_REDIRECT_HTTP=true

# Authentication (optional)
AUTH_ENABLED=false
AUTH_TYPE=jwt
AUTH_EXPIRE_TIME=7d
AUTH_REFRESH_ENABLED=true

# API Security
API_KEY_REQUIRED=false
API_KEYS=api_key_1,api_key_2
API_KEY_HEADER=X-API-Key

# ===================================================================
# FEATURE FLAGS
# ===================================================================

# Core Features
STREAMING_ENABLED=true
BATCH_PROCESSING_ENABLED=true
FILE_UPLOAD_ENABLED=true
EXPORT_ENABLED=true

# AI Features
MULTI_PROVIDER_ENABLED=true
SMART_PROVIDER_SELECTION=true
PROVIDER_HEALTH_CHECK=true
AUTO_FALLBACK_ENABLED=true

# Search Features
WEB_SEARCH_ENABLED=true
SEARCH_RESULT_CACHING=true
SEARCH_AUTO_DETECT=true
SEARCH_RATE_LIMITING=true

# UI Features
REAL_TIME_STATS=true
TYPING_INDICATOR=true
SUGGESTIONS_ENABLED=true
DARK_MODE_DEFAULT=true
RESPONSIVE_DESIGN=true

# Advanced Features
AI_TEMPERATURE_CONTROL=true
CUSTOM_PROMPTS=true
CONVERSATION_MEMORY=true
ANALYTICS_ENABLED=true

# ===================================================================
# INTEGRATIONS
# ===================================================================

# WebSocket Support
WEBSOCKET_ENABLED=false
WEBSOCKET_PORT=3001
WEBSOCKET_PATH=/socket.io

# Webhook Support
WEBHOOK_ENABLED=false
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_ENDPOINTS=/webhook/openai,/webhook/deepseek

# Email Notifications (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Slack Integration (optional)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ===================================================================
# MONITORING & ANALYTICS
# ===================================================================

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Metrics Collection
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics

# Error Tracking
SENTRY_ENABLED=false
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# Analytics
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=
SEGMENT_WRITE_KEY=

# ===================================================================
# FILE PROCESSING
# ===================================================================

# File Upload Settings
UPLOAD_ENABLED=true
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_TYPES=txt,pdf,doc,docx,csv,xlsx,json,md
UPLOAD_DIR=uploads
UPLOAD_TEMP_DIR=temp

# File Processing
PDF_PROCESSING=true
DOCX_PROCESSING=true
CSV_PROCESSING=true
IMAGE_PROCESSING=false
AUDIO_PROCESSING=false

# ===================================================================
# DEVELOPMENT & TESTING
# ===================================================================

# Development Mode
DEBUG_MODE=true
VERBOSE_LOGGING=false
HOT_RELOAD=true
AUTO_RESTART=true

# Testing
TEST_MODE=false
MOCK_RESPONSES=false
TEST_API_DELAYS=false
TEST_CACHE_DISABLED=false

# Benchmarking
BENCHMARK_ENABLED=false
BENCHMARK_ITERATIONS=100
BENCHMARK_CONCURRENT=10

# ===================================================================
# PRODUCTION OPTIMIZATIONS
# ===================================================================

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Static File Serving
STATIC_CACHE_ENABLED=true
STATIC_CACHE_MAX_AGE=86400
STATIC_COMPRESSION=true

# Process Management
CLUSTER_MODE=false
CLUSTER_WORKERS=auto
PM2_ENABLED=false

# CDN Integration
CDN_ENABLED=false
CDN_BASE_URL=https://cdn.example.com
CDN_ASSETS_PATH=/assets

# ===================================================================
# BACKUP & RECOVERY
# ===================================================================

# Automatic Backups
BACKUP_ENABLED=false
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=backups
BACKUP_INCLUDE_LOGS=true

# Recovery
RECOVERY_MODE=false
RECOVERY_BACKUP_PATH=

# ===================================================================
# CUSTOM CONFIGURATIONS
# ===================================================================

# Custom API Endpoints
CUSTOM_ENDPOINTS_ENABLED=false
CUSTOM_MIDDLEWARE_ENABLED=false

# Plugin System
PLUGINS_ENABLED=false
PLUGINS_DIR=plugins
PLUGINS_AUTO_LOAD=true

# Themes & UI Customization
THEME_CUSTOMIZATION=true
CUSTOM_CSS_ENABLED=true
CUSTOM_JS_ENABLED=false

# ===================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ===================================================================

# Development
DEV_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DEV_LOG_LEVEL=debug
DEV_CACHE_ENABLED=true

# Production
PROD_CORS_ORIGIN=https://yourdomain.com
PROD_LOG_LEVEL=error
PROD_CACHE_ENABLED=true
PROD_RATE_LIMIT_STRICT=true

# Staging
STAGING_CORS_ORIGIN=https://staging.yourdomain.com
STAGING_LOG_LEVEL=info
STAGING_MOCK_RESPONSES=false

# ===================================================================
# USAGE NOTES
# ===================================================================
# 1. Copy this file to .env in your project root
# 2. Update all placeholder values with your actual configurations
# 3. Never commit .env to version control
# 4. Use .env.example for template sharing
# 5. Restart server after making changes
# 6. Use environment-specific files (.env.development, .env.production) for different setups
# ===================================================================